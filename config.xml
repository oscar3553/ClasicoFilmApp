<?xml version='1.0' encoding='utf-8'?>
<widget id="com.clasicofilm.tv" version="1.0.1" xmlns="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>ClasicoFilm TV</name>
    <description>Tu catálogo de cine clásico en streaming.</description>
    <author email="soporte@classicofilm.com" href="https://www.classicofilm.com">Óscar - ClasicoFilm</author>
    
    <content src="index.html" />
    
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="*" />
    <allow-navigation href="https://*/*" />
    <allow-navigation href="http://*/*" />

    <platform name="android">
        <preference name="Orientation" value="landscape" />
        <preference name="AndroidLaunchMode" value="singleTop" />
        <preference name="KeepRunning" value="true" />
        
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        </config-file>
        
        <edit-config target="AndroidManifest.xml" parent="/manifest/application" mode="merge">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
    
    <preference name="Fullscreen" value="true" />
<icon src="https://blogger.googleusercontent.com/img/a/AVvXsEgpLF6ROFXXw42soEaNVYLsA7ZPqgnzhGWN-id-bGZ0GfPbfeO08bxXlPv6KgdiOPMAOrsjOu8V-WXIUhlTYRYlU6KQthnIL0VcP1-D1l7CJImrszfdjCImWIMOMgoBYl5MwPot7B7SeRqyx3TzBUP2q1AXRgr_hS1zlGMPnh4VEMTvEz9Lq0f1AytDFWog=s158" />
<allow-navigation href="https://blogger.googleusercontent.com/*" />
<access origin="https://blogger.googleusercontent.com" />
</widget>
